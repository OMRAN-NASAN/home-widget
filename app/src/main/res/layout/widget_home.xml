<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/remote_bg" android:padding="8dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:paddingBottom="6dp" android:textColor="#9AA3B2" android:textSize="13sp" android:textStyle="bold"/>
<GridView android:id="@+id/keyGrid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:cacheColorHint="@android:color/transparent" android:horizontalSpacing="6dp" android:listSelector="@android:color/transparent" android:numColumns="4" android:overScrollMode="never" android:stretchMode="columnWidth" android:verticalSpacing="6dp"/>
</LinearLayout>
</FrameLayout>
